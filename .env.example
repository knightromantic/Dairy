# PostgreSQL（本地 Docker / Neon / Supabase / Railway 等）
#
# Neon 建议在 Vercel 同时配置两条（控制台 Connect 里可切换 Pooled / Direct）：
# - DATABASE_URL：Pooled（主机名含 -pooler），给 Next.js 运行时
# - DIRECT_URL：Direct（不含 -pooler），给 prisma migrate deploy
# 二者都要带 ?sslmode=require（以 Neon 复制为准）
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/diary?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/diary?schema=public"

# iron-session，至少 32 个字符
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ========== 部署提示（Vercel）==========
# 1. 在 Neon 等创建数据库，把 DATABASE_URL、DIRECT_URL、SESSION_SECRET 配到 Vercel Environment Variables。
# 2. Build Command 建议：npx prisma migrate deploy && prisma generate && next build
#    （本地打包不含 migrate deploy，避免没装数据库时 build 失败）
